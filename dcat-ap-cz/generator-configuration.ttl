    kv:useGenerators "{\"json\":false,\"jsonExample\":false,\"xml\":false,\"csv\":false,\"sparql\":false,\"shacl\":false,\"shex\":false,\"openapi\":false,\"plantUML\":false}".
:id a <https://dataspecer.com/work-in-progress/generator-configuration/configuration-entry/>;
