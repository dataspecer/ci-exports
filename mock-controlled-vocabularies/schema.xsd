  </xs:simpleType>
  <xs:simpleType name="must_a_object-iri">
    <xs:restriction base="xs:anyURI">
      <xs:pattern value="http://example\.com/cv-a/[a-z]+"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="recommended_a_restrict-iri">
