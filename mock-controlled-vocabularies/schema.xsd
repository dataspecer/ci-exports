      <xs:pattern value="http://example\.com/cv-a/[a-z]+"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="recommended_a_both-iri">
    <xs:restriction base="xs:anyURI">
      <xs:pattern value="http://example\.com/cv-a/[a-z]+"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="test" sawsdl:modelReference="http://example.com/vocabulary#Test">
    <xs:annotation>
      <xs:documentation xml:lang="en">
        Test
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="must_a" type="must_a-iri" sawsdl:modelReference="http://example.com/vocabulary#must_a">
        <xs:annotation>
          <xs:documentation xml:lang="en">
            must_a
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="must_a_class_regex" type="must_a_class_regex-iri" sawsdl:modelReference="http://example.com/vocabulary#must_a_class_regex">
        <xs:annotation>
          <xs:documentation xml:lang="en">
            must_a_class_regex
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="must_a_single" type="must_a_single-iri" sawsdl:modelReference="http://example.com/vocabulary#must_a_single">
        <xs:annotation>
          <xs:documentation xml:lang="en">
            must_a_single
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="must_a_object" sawsdl:modelReference="http://example.com/vocabulary#must_a_object">
        <xs:annotation>
          <xs:documentation xml:lang="en">
            must_a_object
          </xs:documentation>
        </xs:annotation>
        <xs:complexType sawsdl:modelReference="http://example.com/vocabulary#Value_must_a_object">
          <xs:annotation>
            <xs:documentation xml:lang="en">
              Value must_a_object
            </xs:documentation>
          </xs:annotation>
          <xs:sequence>
            <xs:element name="iri" type="must_a_object-iri"/>
            <xs:element minOccurs="0" name="label" type="xs:string" sawsdl:modelReference="http://example.com/vocabulary#label_must_a_object">
              <xs:annotation>
                <xs:documentation xml:lang="en">
                  label
                </xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax" namespace="##other"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="at_least_one_a" type="xs:anyURI" sawsdl:modelReference="http://example.com/vocabulary#at_least_one_a">
        <xs:annotation>
          <xs:documentation xml:lang="en">
            at_least_one_a
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="at_least_one_a_single" type="xs:anyURI" sawsdl:modelReference="http://example.com/vocabulary#at_least_one_a_single">
        <xs:annotation>
          <xs:documentation xml:lang="en">
            at_least_one_a_single
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="at_least_one_a_object" sawsdl:modelReference="http://example.com/vocabulary#at_least_one_a_object">
        <xs:annotation>
          <xs:documentation xml:lang="en">
            at_least_one_a_object
          </xs:documentation>
        </xs:annotation>
        <xs:complexType sawsdl:modelReference="http://example.com/vocabulary#Value_at_least_one_a_object">
          <xs:annotation>
            <xs:documentation xml:lang="en">
              Value at_least_one_a_object
            </xs:documentation>
          </xs:annotation>
          <xs:sequence>
            <xs:element name="iri" type="xs:anyURI"/>
            <xs:element minOccurs="0" name="label" type="xs:string" sawsdl:modelReference="http://example.com/vocabulary#label_at_least_one_a_object">
              <xs:annotation>
                <xs:documentation xml:lang="en">
                  label
                </xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax" namespace="##other"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="at_least_one_a_and_b" type="xs:anyURI" sawsdl:modelReference="http://example.com/vocabulary#at_least_one_a_and_b">
        <xs:annotation>
          <xs:documentation xml:lang="en">
            at_least_one_a_and_b
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="recommended_a_default" type="xs:anyURI" sawsdl:modelReference="http://example.com/vocabulary#recommended_a_default">
        <xs:annotation>
          <xs:documentation xml:lang="en">
            recommended_a_default
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="recommended_a_require" type="xs:anyURI" sawsdl:modelReference="http://example.com/vocabulary#recommended_a_require">
        <xs:annotation>
          <xs:documentation xml:lang="en">
            recommended_a_require
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="recommended_a_restrict" type="recommended_a_restrict-iri" sawsdl:modelReference="http://example.com/vocabulary#recommended_a_restrict">
        <xs:annotation>
          <xs:documentation xml:lang="en">
            recommended_a_restrict
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="recommended_a_both" type="recommended_a_both-iri" sawsdl:modelReference="http://example.com/vocabulary#recommended_a_both">
        <xs:annotation>
          <xs:documentation xml:lang="en">
            recommended_a_both
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="may_a" type="xs:anyURI" sawsdl:modelReference="http://example.com/vocabulary#may_a">
        <xs:annotation>
          <xs:documentation xml:lang="en">
            may_a
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="must_without_pattern" type="xs:anyURI" sawsdl:modelReference="http://example.com/vocabulary#must_without_pattern">
        <xs:annotation>
          <xs:documentation xml:lang="en">
            must_without_pattern
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="at_least_one_a_recommended_b_require" type="xs:anyURI" sawsdl:modelReference="http://example.com/vocabulary#at_least_one_a_recommended_b_require">
        <xs:annotation>
          <xs:documentation xml:lang="en">
            at_least_one_a_recommended_b_require
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax" namespace="##other"/>
    </xs:sequence>
    <xs:assert test="not(*:at_least_one_a) or *:at_least_one_a[matches(., '^(http://example\.com/cv-a/[a-z]+)$')]"/>
    <xs:assert test="not(*:at_least_one_a_single) or *:at_least_one_a_single[matches(., '^(http://example\.com/cv-a/[a-z]+)$')]"/>
    <xs:assert test="not(*:at_least_one_a_object) or *:at_least_one_a_object/*:iri[matches(., '^(http://example\.com/cv-a/[a-z]+)$')]"/>
    <xs:assert test="not(*:at_least_one_a_and_b) or *:at_least_one_a_and_b[matches(., '^(http://example\.com/cv-a/[a-z]+)$')]"/>
    <xs:assert test="not(*:at_least_one_a_and_b) or *:at_least_one_a_and_b[matches(., '^(http://example\.com/cv-b/[0-9]+)$')]"/>
    <xs:assert test="not(*:recommended_a_require) or *:recommended_a_require[matches(., '^(http://example\.com/cv-a/[a-z]+)$')]"/>
    <xs:assert test="not(*:recommended_a_both) or *:recommended_a_both[matches(., '^(http://example\.com/cv-a/[a-z]+)$')]"/>
    <xs:assert test="not(*:at_least_one_a_recommended_b_require) or *:at_least_one_a_recommended_b_require[matches(., '^(http://example\.com/cv-a/[a-z]+)$')]"/>
    <xs:assert test="not(*:at_least_one_a_recommended_b_require) or *:at_least_one_a_recommended_b_require[matches(., '^(http://example\.com/cv-b/[0-9]+)$')]"/>
