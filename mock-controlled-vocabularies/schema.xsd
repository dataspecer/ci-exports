<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" vc:minVersion="1.1" elementFormDefault="unqualified" xmlns:sawsdl="http://www.w3.org/ns/sawsdl">
  <xs:simpleType name="must_a-iri">
    <xs:restriction base="xs:anyURI">
      <xs:pattern value="http://example\.com/cv-a/[a-z]+"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="must_a_class_regex-iri-1">
    <xs:restriction base="xs:anyURI">
      <xs:pattern value="http://example\.com/cv-a/r.*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="must_a_class_regex-iri">
    <xs:restriction base="must_a_class_regex-iri-1">
      <xs:pattern value="http://example\.com/cv-a/[a-z]+"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="must_a_single-iri">
    <xs:restriction base="xs:anyURI">
      <xs:pattern value="http://example\.com/cv-a/[a-z]+"/>
