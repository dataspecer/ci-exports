@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix dct: <http://purl.org/dc/terms/>.
@prefix dcat: <http://www.w3.org/ns/dcat#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.

<http://example.com/profile/controlled-vocabulary-catalog/cv-json-schema-test-v2> a dcat:Catalog;
    dcat:dataset <http://example.com/profile/controlled-vocabulary-catalog/cv-json-schema-test-v2/dataset/cv-json-schema-test-v2-cv-a>.
<http://example.com/profile/controlled-vocabulary-catalog/cv-json-schema-test-v2/dataset/cv-json-schema-test-v2-cv-a> a dcat:Dataset;
    dct:title "CV A (letters)"@en;
    dct:references <http://example.com/schemes/a>;
    dct:conformsTo <http://www.w3.org/2004/02/skos/core>;
    sh:pattern "^http://example\\.com/cv-a/[a-z]+$";
    dcat:distribution [
  a dcat:Distribution;
  dcat:accessURL <http://example.com/vocabularies/a>
].
<http://example.com/profile/controlled-vocabulary-catalog/cv-json-schema-test-v2> dcat:dataset <http://example.com/profile/controlled-vocabulary-catalog/cv-json-schema-test-v2/dataset/cv-json-schema-test-v2-cv-b>.
<http://example.com/profile/controlled-vocabulary-catalog/cv-json-schema-test-v2/dataset/cv-json-schema-test-v2-cv-b> a dcat:Dataset;
    dct:title "CV B (digits)"@en;
    dct:references <http://example.com/schemes/b>;
    dct:conformsTo <http://www.w3.org/2004/02/skos/core>;
    sh:pattern "^http://example\\.com/cv-b/[0-9]+$";
    dcat:distribution [
  a dcat:Distribution;
  dcat:accessURL <http://example.com/vocabularies/b>
].
<http://example.com/profile/controlled-vocabulary-catalog/cv-json-schema-test-v2> dcat:dataset <http://example.com/profile/controlled-vocabulary-catalog/cv-json-schema-test-v2/dataset/cv-json-schema-test-v2-cv-none>.
<http://example.com/profile/controlled-vocabulary-catalog/cv-json-schema-test-v2/dataset/cv-json-schema-test-v2-cv-none> a dcat:Dataset;
    dct:title "CV without a pattern"@en;
    dct:references <http://example.com/schemes/none>;
    dct:conformsTo <http://www.w3.org/2004/02/skos/core>;
    dcat:distribution [
  a dcat:Distribution;
  dcat:accessURL <http://example.com/vocabularies/none>
].
